{
  "swagger": "2.0",
  "info": {
    "version": "1.0.0",
    "title": "REST API de Videojuegos",
    "description": "API profesional con autenticación OAuth, validación de datos y manejo de errores."
  },
  "securityDefinitions": {
    "OAuth2": {
      "type": "oauth2",
      "flow": "implicit",
      "authorizationUrl": "https://cse341-webservices-jp5b.onrender.com/login",
      "scopes": {}
    }
  },
  "host": "cse341-webservices-jp5b.onrender.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "paths": {
    "/categories/": {
      "get": {
        "description": "Obtener todas las categorías",
        "produces": ["application/json"],
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "description": "Crear nueva categoría",
        "parameters": [{
          "name": "body", "in": "body", "schema": {
            "type": "object",
            "properties": {
              "name": { "type": "string" }, "description": { "type": "string" }, "type": { "type": "string" },
              "popularity": { "type": "string" }, "active": { "type": "boolean" }, "createdYear": { "type": "integer" }, "language": { "type": "string" }
            }
          }
        }],
        "responses": { "201": { "description": "Created" }, "400": { "description": "Bad Request" }, "500": { "description": "Internal Server Error" } }
      }
    },
    "/categories/{id}": {
      "put": {
        "description": "Actualizar categoría",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          { "name": "body", "in": "body", "schema": { "type": "object", "properties": { "name": { "type": "string" }, "description": { "type": "string" }, "type": { "type": "string" }, "popularity": { "type": "string" }, "active": { "type": "boolean" }, "createdYear": { "type": "integer" }, "language": { "type": "string" } } } }
        ],
        "responses": { "204": { "description": "No Content" }, "500": { "description": "Internal Server Error" } }
      },
      "delete": {
        "description": "Borrar categoría",
        "parameters": [{ "name": "id", "in": "path", "required": true, "type": "string" }],
        "responses": { "200": { "description": "OK" }, "500": { "description": "Internal Server Error" } }
      }
    },
    "/games/": {
      "get": {
        "description": "Obtener todos los juegos",
        "produces": ["application/json"],
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "description": "Crear nuevo juego",
        "parameters": [{
          "name": "body", "in": "body", "schema": {
            "type": "object",
            "properties": {
              "name": { "type": "string" }, "genre": { "type": "string" }, "developer": { "type": "string" },
              "releaseYear": { "type": "integer" }, "platform": { "type": "string" }, "rating": { "type": "number" }, "multiplayer": { "type": "boolean" }
            }
          }
        }],
        "responses": { "201": { "description": "Created" }, "400": { "description": "Bad Request" }, "500": { "description": "Internal Server Error" } }
      }
    },
    "/games/{id}": {
      "put": {
        "description": "Actualizar juego",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          { "name": "body", "in": "body", "schema": { "type": "object", "properties": { "name": { "type": "string" }, "genre": { "type": "string" }, "developer": { "type": "string" }, "releaseYear": { "type": "integer" }, "platform": { "type": "string" }, "rating": { "type": "number" }, "multiplayer": { "type": "boolean" } } } }
        ],
        "responses": { "204": { "description": "No Content" }, "500": { "description": "Internal Server Error" } }
      },
      "delete": {
        "description": "Borrar juego",
        "parameters": [{ "name": "id", "in": "path", "required": true, "type": "string" }],
        "responses": { "200": { "description": "OK" }, "500": { "description": "Internal Server Error" } }
      }
    }
  }
}